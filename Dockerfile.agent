# Run the complete controller, tool layer, and tests in one container.
# Source repositories should be mounted read-only; artifacts need a writable mount.
FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY patchpilot/ ./patchpilot/
COPY examples/ ./examples/
ENV PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
USER 10001:10001
ENTRYPOINT ["python", "-m", "patchpilot"]
CMD ["demo", "--runner", "local", "--output", "/artifacts"]
